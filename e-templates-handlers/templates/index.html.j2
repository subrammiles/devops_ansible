<!DOCTYPE html>
<html>
<head>
  <title>{{ site_title }}</title>
</head>
<body>
  <h1>{{ site_title }}</h1>
  <p>Served by <strong>{{ ansible_hostname }}</strong> ({{ ansible_default_ipv4.address | default('unknown IP') }})</p>
  <p>OS: {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
  <h2>Team</h2>
  <ul>
{% for member in team %}
    <li>{{ member }}</li>
{% endfor %}
  </ul>
</body>
</html>
